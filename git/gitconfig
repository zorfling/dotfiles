[user]
	name = Chris Colborne
	email = zorfling@gmail.com
[core]
	quotepath = false
    excludesfile = ~/.gitignore
    #editor = /usr/bin/vim
    editor = code --wait
    untrackedCache=true
    fsmonitor=true

[alias]
    co = checkout
    ci = commit
    rb = rebase
    st = status
    glog = log --graph
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ch)%C(bold blue)<%an>%Creset' --abbrev-commit
    lg5 = lg -n5
    in = !git fetch && git log HEAD..FETCH_HEAD
    out = !git fetch && git log FETCH_HEAD..HEAD
	recent = for-each-ref --count=10 --sort=-committerdate refs/heads/ --format=\"%(refname:short)\"
    follow = lg -M --follow

[diff]
    tool = vscode

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    tool = vscode

[mergetool "vscode"]
    cmd = code --wait $MERGED

[push]
    default = current
	autoSetupRemote = true
[credential]
	helper = cache
	azreposCredentialType = oauth
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
#[merge]
#    tool = vimdiff
#    conflictstyle = diff3
#    prompt = false
[color]
    ui = true
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[pull]
	rebase = false

